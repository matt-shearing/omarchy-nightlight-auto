#!/usr/bin/env python3
"""Sunset-tracked night light for Omarchy.

hyprsunset only understands wall-clock profiles, so this generates a ladder of
them: a ramp that starts at local sunset and warms the screen in steps through
the evening, holds overnight, and returns to an untinted display at sunrise.
The ladder is regenerated daily because sunset moves.

Location comes from the system time zone by default -- tzdata's zone1970.tab
carries a representative lat/long for every zone -- so changing the time zone
moves the schedule with it. Override it in the config file if you want the
exact coordinates for where you actually are.

Writes ~/.config/hypr/hyprsunset.conf, which is Omarchy's documented extension
point for this. Nothing under /usr/share/omarchy is touched.
"""

from __future__ import annotations

import argparse
import json
import math
import os
import subprocess
import time
import sys
from datetime import date, datetime, timedelta, timezone
from pathlib import Path
from zoneinfo import ZoneInfo

HOME = Path.home()
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
SETTINGS_PATH = CONFIG_DIR / "nightlight-auto" / "config.json"
HYPRSUNSET_CONF = CONFIG_DIR / "hypr" / "hyprsunset.conf"
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "nightlight-auto"
STATE_PATH = STATE_DIR / "state.json"
PAUSE_PATH = STATE_DIR / "paused"
CONSENT_PATH = STATE_DIR / "consent.json"

REPO = Path(__file__).resolve().parent.parent
UNIT_DIR = CONFIG_DIR / "systemd" / "user"
HOOK_PATH = CONFIG_DIR / "omarchy" / "hooks" / "post-boot.d" / "nightlight-auto.sh"
PRE_BACKUP = HYPRSUNSET_CONF.with_name("hyprsunset.conf.pre-nightlight-auto")
HYPRSUNSET_UNIT = "hyprsunset.service"

MARKER = "# generated by nightlight-auto"

DEFAULTS = {
    # null => derive from the system time zone via tzdata's zone1970.tab
    "latitude": None,
    "longitude": None,
    # Kelvin at the start of the evening ramp, and at its deepest point.
    # The start defaults to the daytime value so the ramp begins from no tint
    # rather than stepping straight to a visible one.
    "evening_temp": 6500,
    "night_temp": 3000,
    # null => untinted (hyprsunset identity matrix) during the day.
    "day_temp": None,
    # Where the evening ramp is anchored: "sunset", "civil_dusk",
    # "nautical_dusk" or "astronomical_dusk". Sunset is still daylight; civil
    # dusk is about when you reach for a lamp.
    "ramp_anchor": "civil_dusk",
    # Ramp geometry, in minutes.
    "ramp_start_offset_min": 0,   # relative to the anchor; negative starts earlier
    "ramp_minutes": 300,          # anchor -> night_temp over five hours
    "step_minutes": 20,           # granularity of the ladder
    # Shape of the ramp. 1.0 is a straight line in mireds; higher values hold
    # near the daytime value for longer and do most of the warming later, so
    # nothing is noticeable while there is still light outside.
    "ramp_curve_power": 2.0,
    "morning_offset_min": 0,      # relative to sunrise; when day returns
    # Used only when the sun does not rise or set (high latitudes).
    "fallback_sunset": "18:00",
    "fallback_sunrise": "06:00",
    # Round emitted temperatures to this multiple, to keep the file readable.
    "round_to_kelvin": 50,
}

# ---------------------------------------------------------------- settings


def load_settings() -> dict:
    settings = dict(DEFAULTS)
    if SETTINGS_PATH.exists():
        try:
            user = json.loads(SETTINGS_PATH.read_text())
        except json.JSONDecodeError as exc:
            die(f"{SETTINGS_PATH}: {exc}")
        unknown = set(user) - set(DEFAULTS)
        if unknown:
            warn(f"ignoring unknown setting(s): {', '.join(sorted(unknown))}")
        settings.update({k: v for k, v in user.items() if k in DEFAULTS})
    validate(settings)
    return settings


def validate(s: dict) -> None:
    for key in ("evening_temp", "night_temp"):
        if not (1000 <= s[key] <= 20000):
            die(f"{key} must be between 1000 and 20000 K (got {s[key]})")
    if s["day_temp"] is not None and not (1000 <= s["day_temp"] <= 20000):
        die(f"day_temp must be between 1000 and 20000 K (got {s['day_temp']})")
    if s["ramp_minutes"] < 1:
        die("ramp_minutes must be at least 1")
    if not (1 <= s["step_minutes"] <= s["ramp_minutes"]):
        die("step_minutes must be between 1 and ramp_minutes")
    if s["round_to_kelvin"] < 1:
        die("round_to_kelvin must be at least 1")
    if s["ramp_anchor"] not in _ALTITUDES:
        die(f"ramp_anchor must be one of {', '.join(_ALTITUDES)} "
            f"(got {s['ramp_anchor']!r})")
    if not (0.1 <= s["ramp_curve_power"] <= 10):
        die(f"ramp_curve_power must be between 0.1 and 10 "
            f"(got {s['ramp_curve_power']})")
    for key in ("fallback_sunset", "fallback_sunrise"):
        try:
            hh, mm = (int(part) for part in s[key].split(":"))
            assert 0 <= hh < 24 and 0 <= mm < 60
        except (ValueError, AssertionError):
            die(f"{key} must be HH:MM (got {s[key]!r})")


def write_default_settings() -> bool:
    """Drop a commented starting config in place. True if it created one."""
    if SETTINGS_PATH.exists():
        return False
    SETTINGS_PATH.parent.mkdir(parents=True, exist_ok=True)
    SETTINGS_PATH.write_text(json.dumps(DEFAULTS, indent=2) + "\n")
    return True


# ---------------------------------------------------------------- location


def system_timezone() -> str:
    tz = os.environ.get("TZ")
    if tz:
        return tz
    localtime = Path("/etc/localtime")
    if localtime.is_symlink():
        target = os.path.realpath(localtime)
        marker = "/zoneinfo/"
        if marker in target:
            return target.split(marker, 1)[1]
    tzfile = Path("/etc/timezone")
    if tzfile.exists():
        name = tzfile.read_text().strip()
        if name:
            return name
    die("could not determine the system time zone")


def _parse_iso6709(coords: str) -> tuple[float, float]:
    """Split zone.tab's +DDMM+DDDMM / +DDMMSS+DDDMMSS into degrees."""
    split = max(coords.rfind("+"), coords.rfind("-"))
    if split <= 0:
        raise ValueError(f"malformed coordinates: {coords!r}")
    lat_s, lon_s = coords[:split], coords[split:]

    def to_degrees(text: str, deg_digits: int) -> float:
        sign = -1.0 if text[0] == "-" else 1.0
        digits = text[1:]
        deg = int(digits[:deg_digits])
        minutes = int(digits[deg_digits:deg_digits + 2])
        seconds = int(digits[deg_digits + 2:deg_digits + 4] or 0)
        return sign * (deg + minutes / 60 + seconds / 3600)

    return to_degrees(lat_s, 2), to_degrees(lon_s, 3)


def location_from_timezone(tz_name: str) -> tuple[float, float]:
    tables = ("/usr/share/zoneinfo/zone1970.tab", "/usr/share/zoneinfo/zone.tab")
    for table in tables:
        path = Path(table)
        if not path.exists():
            continue
        for line in path.read_text().splitlines():
            if not line or line.startswith("#"):
                continue
            fields = line.split("\t")
            if len(fields) < 3:
                continue
            # zone1970.tab lists several zone names per row, comma-separated.
            if tz_name in fields[2].split(","):
                return _parse_iso6709(fields[1])
    die(
        f"time zone {tz_name!r} is not in tzdata's zone tables; "
        f"set latitude/longitude in {SETTINGS_PATH}"
    )


def resolve_location(settings: dict, tz_name: str) -> tuple[float, float, str]:
    lat, lon = settings["latitude"], settings["longitude"]
    if lat is not None and lon is not None:
        return float(lat), float(lon), "config"
    if (lat is None) != (lon is None):
        die("set both latitude and longitude, or neither")
    lat, lon = location_from_timezone(tz_name)
    return lat, lon, f"time zone ({tz_name})"


# ------------------------------------------------------------------- solar

# NOAA's low-precision sunrise equation. Good to a minute or two, which is far
# below the granularity anything here cares about.

_J2000 = 2451545.0
_OBLIQUITY = math.radians(23.4397)
# Solar altitudes, in degrees. Sunset is the refraction-corrected disc; the
# twilights are the standard definitions. Civil dusk is roughly when you would
# want a lamp on indoors; by nautical dusk it is properly dark outside.
_ALTITUDES = {
    "sunset": -0.833,
    "civil_dusk": -6.0,
    "nautical_dusk": -12.0,
    "astronomical_dusk": -18.0,
}
_HORIZON = math.radians(_ALTITUDES["sunset"])


def _julian_from_ordinal(day: date) -> float:
    """Julian date at 12:00 UTC on the given calendar date."""
    return day.toordinal() + 1721425.0


def _julian_to_datetime(jd: float, tz: ZoneInfo) -> datetime:
    unix = (jd - 2440587.5) * 86400.0
    return datetime.fromtimestamp(unix, tz=timezone.utc).astimezone(tz)


def _solar_events(n: int, lat: float, lon: float,
                  altitude_deg: float = _ALTITUDES["sunset"]) -> tuple[float, float] | None:
    """Return (julian_rise, julian_set) for solar cycle n at the given solar
    altitude, or None if the sun never reaches it that day."""
    lw = -lon  # the equation wants west-positive longitude
    j_star = n + 0.0009 + lw / 360.0
    mean_anomaly = math.radians((357.5291 + 0.98560028 * j_star) % 360.0)
    center = (
        1.9148 * math.sin(mean_anomaly)
        + 0.0200 * math.sin(2 * mean_anomaly)
        + 0.0003 * math.sin(3 * mean_anomaly)
    )
    ecliptic_lon = math.radians(
        (math.degrees(mean_anomaly) + center + 180.0 + 102.9372) % 360.0
    )
    transit = (
        _J2000
        + j_star
        + 0.0053 * math.sin(mean_anomaly)
        - 0.0069 * math.sin(2 * ecliptic_lon)
    )
    declination = math.asin(math.sin(ecliptic_lon) * math.sin(_OBLIQUITY))
    phi = math.radians(lat)
    numerator = (math.sin(math.radians(altitude_deg))
                 - math.sin(phi) * math.sin(declination))
    denominator = math.cos(phi) * math.cos(declination)
    if denominator == 0:
        return None
    cos_hour_angle = numerator / denominator
    if not -1.0 <= cos_hour_angle <= 1.0:
        return None  # polar day or polar night
    hour_angle = math.degrees(math.acos(cos_hour_angle))
    return transit - hour_angle / 360.0, transit + hour_angle / 360.0


def sun_times(day: date, lat: float, lon: float, tz: ZoneInfo,
              altitude_deg: float = _ALTITUDES["sunset"]):
    """Local (rise, set) for the given local date at the given solar altitude,
    or (None, None) if the sun never reaches it. The default is sunrise and
    sunset; pass a twilight altitude for dawn and dusk."""
    n0 = round(_julian_from_ordinal(day) - _J2000 - 0.0009 + lon / 360.0)
    # The cycle number can land a day either side; nudge until the transit
    # falls on the date we were asked about.
    for n in (n0, n0 - 1, n0 + 1, n0 - 2, n0 + 2):
        events = _solar_events(n, lat, lon, altitude_deg)
        if events is None:
            return None, None
        rise, sets = (_julian_to_datetime(jd, tz) for jd in events)
        midpoint = _julian_to_datetime((events[0] + events[1]) / 2, tz)
        if midpoint.date() == day:
            return rise, sets
    return None, None


def _fallback(day: date, hhmm: str, tz: ZoneInfo) -> datetime:
    hh, mm = (int(part) for part in hhmm.split(":"))
    return datetime(day.year, day.month, day.day, hh, mm, tzinfo=tz)


# ------------------------------------------------------------------ ladder


def _mired(kelvin: float) -> float:
    return 1_000_000.0 / kelvin


def build_schedule(settings: dict, day: date, lat: float, lon: float, tz: ZoneInfo):
    """Return (steps, info). steps is [(datetime, temperature_or_None)] in
    chronological order across tonight; None means an untinted day profile."""
    _, sunset = sun_times(day, lat, lon, tz)
    tomorrow = day + timedelta(days=1)
    sunrise_next, _ = sun_times(tomorrow, lat, lon, tz)

    # The ramp hangs off dusk, not sunset: at sunset it is still light out, and
    # anything visible then reads as the filter firing too early.
    anchor_name = settings["ramp_anchor"]
    _, anchor = sun_times(day, lat, lon, tz, _ALTITUDES[anchor_name])
    if anchor is None:
        # Somewhere the sun never gets that far below the horizon. Fall back to
        # sunset rather than skipping the evening entirely.
        anchor, anchor_name = sunset, "sunset"

    degenerate = sunset is None or sunrise_next is None
    if sunset is None:
        sunset = _fallback(day, settings["fallback_sunset"], tz)
    if anchor is None:
        anchor = sunset
    if sunrise_next is None:
        sunrise_next = _fallback(tomorrow, settings["fallback_sunrise"], tz)

    ramp_start = anchor + timedelta(minutes=settings["ramp_start_offset_min"])
    day_start = sunrise_next + timedelta(minutes=settings["morning_offset_min"])

    step = timedelta(minutes=settings["step_minutes"])
    ramp = timedelta(minutes=settings["ramp_minutes"])

    # Never let the ramp run into the morning profile.
    latest_end = day_start - step
    if ramp_start >= latest_end:
        warn("night is shorter than one ramp step; emitting a single night profile")
        steps = [(ramp_start, settings["night_temp"])]
        return _finish(steps, day_start, settings), {
            "sunset": sunset, "sunrise": sunrise_next, "degenerate": degenerate,
            "ramp_start": ramp_start, "ramp_end": ramp_start, "day_start": day_start,
            "anchor": anchor, "anchor_name": anchor_name,
        }
    ramp_end = min(ramp_start + ramp, latest_end)

    total = (ramp_end - ramp_start).total_seconds()
    count = max(1, int(round(total / step.total_seconds())))
    m_start, m_end = _mired(settings["evening_temp"]), _mired(settings["night_temp"])
    quantum = settings["round_to_kelvin"]

    power = settings["ramp_curve_power"]
    steps = []
    for i in range(count + 1):
        # Interpolate in mireds, because even steps there read as even steps to
        # the eye. The power curve then biases the movement towards the later
        # part of the evening, so the first hour is barely perceptible.
        fraction = (i / count) ** power
        kelvin = 1_000_000.0 / (m_start + fraction * (m_end - m_start))
        steps.append((ramp_start + i * (ramp_end - ramp_start) / count,
                      int(round(kelvin / quantum) * quantum)))

    return _finish(steps, day_start, settings), {
        "sunset": sunset, "sunrise": sunrise_next, "degenerate": degenerate,
        "ramp_start": ramp_start, "ramp_end": ramp_end, "day_start": day_start,
        "anchor": anchor, "anchor_name": anchor_name,
    }


def _finish(steps, day_start, settings):
    """Append the morning profile and collapse anything that repeats."""
    steps = list(steps) + [(day_start, settings["day_temp"])]
    collapsed = []
    for when, temp in steps:
        key = when.strftime("%H:%M")
        if collapsed and collapsed[-1][0].strftime("%H:%M") == key:
            collapsed[-1] = (when, temp)  # later entry wins on a collision
            continue
        if collapsed and collapsed[-1][1] == temp:
            continue  # same temperature as the previous step, so it is a no-op
        collapsed.append((when, temp))
    return collapsed


# ------------------------------------------------------------------ render


def render_paused_conf(tz_name: str) -> str:
    """A single identity profile: the display stays untinted around the clock."""
    return "\n".join([
        MARKER,
        "# Paused. Run `nightlight-auto resume` to put the ramp back.",
        f"# Settings live in {SETTINGS_PATH}",
        "#",
        f"# time zone : {tz_name}",
        "",
        "profile {",
        "    time = 00:00",
        "    identity = true",
        "}",
        "",
    ])


def render_conf(steps, settings, info, lat, lon, source, tz_name) -> str:
    lines = [
        MARKER,
        "# Do not edit; run `nightlight-auto generate` to rebuild.",
        f"# Settings live in {SETTINGS_PATH}",
        "#",
        f"# time zone : {tz_name}",
        f"# location  : {lat:.4f}, {lon:.4f}  (from {source})",
        f"# ramp from : {info['anchor_name'].replace('_', ' ')} at "
        f"{info['anchor'].strftime('%H:%M')}",
        f"# sunset    : {info['sunset'].strftime('%H:%M')}"
        f"   sunrise: {info['sunrise'].strftime('%H:%M')}"
        + ("   (estimated: the sun did not set)" if info["degenerate"] else ""),
        f"# ramp      : {settings['evening_temp']}K -> {settings['night_temp']}K"
        f" over {settings['ramp_minutes']} min"
        f" (curve {settings['ramp_curve_power']})",
        "",
    ]
    # hyprsunset treats the profile list as a 24h cycle and wraps past the last
    # entry, so plain chronological order by clock time is what it wants.
    for when, temp in sorted(steps, key=lambda item: item[0].strftime("%H:%M")):
        lines.append("profile {")
        lines.append(f"    time = {when.strftime('%H:%M')}")
        if temp is None:
            lines.append("    identity = true")
        else:
            lines.append(f"    temperature = {temp}")
        lines.append("}")
        lines.append("")
    return "\n".join(lines)


# ------------------------------------------------------------------ apply


def hyprsunset_running() -> bool:
    return subprocess.run(["pgrep", "-x", "hyprsunset"],
                          capture_output=True).returncode == 0


UNIT = "hyprsunset.service"


def unit_active() -> bool:
    out = subprocess.run(["systemctl", "--user", "is-active", UNIT],
                         capture_output=True, text=True)
    return out.stdout.strip() == "active"


def restart_hyprsunset() -> bool:
    """Reload the config. hyprsunset reads it only at startup.

    This deliberately does not go through omarchy-restart-hyprsunset. That
    relaunches via uwsm, which asks the user manager for a transient scope --
    and a scope created from inside a systemd service does not outlive the
    service that created it. Run from the timer, hyprsunset comes up, answers
    on its socket, and is then killed the moment the oneshot exits. The unit
    that the hyprsunset package ships has no such problem, so drive that.
    """
    if unit_active():
        subprocess.run(["systemctl", "--user", "restart", UNIT], capture_output=True)
    elif hyprsunset_running():
        # Started by hand or by `omarchy toggle nightlight`, so it is outside
        # systemd's control. Clear it and let the unit take ownership.
        subprocess.run(["pkill", "-x", "hyprsunset"], capture_output=True)
        for _ in range(25):
            if not hyprsunset_running():
                break
            time.sleep(0.2)
        subprocess.run(["systemctl", "--user", "start", UNIT], capture_output=True)
    else:
        return False  # nothing to reload; the new schedule applies at next login

    if _wait_for_hyprsunset():
        return True
    warn("hyprsunset did not come back after the restart")
    return False


def _wait_for_hyprsunset(timeout: float = 10.0) -> bool:
    """Poll until the relaunched hyprsunset is up and answering on its socket."""
    deadline = time.monotonic() + timeout
    seen = False
    while time.monotonic() < deadline:
        if hyprsunset_running():
            seen = True
            # Answering IPC means it is past startup, so the scope handoff is done.
            if current_temperature() is not None:
                return True
        time.sleep(0.2)
    return seen


def save_state(payload: dict) -> None:
    STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    STATE_PATH.write_text(json.dumps(payload, indent=2) + "\n")


def is_setup() -> bool:
    return CONSENT_PATH.exists()


def read_consent() -> dict:
    try:
        return json.loads(CONSENT_PATH.read_text())
    except (OSError, json.JSONDecodeError):
        return {}


def unit_enabled(unit: str) -> bool:
    out = subprocess.run(["systemctl", "--user", "is-enabled", unit],
                         capture_output=True, text=True)
    return out.stdout.strip() == "enabled"


def autostart_launches_hyprsunset() -> bool:
    path = CONFIG_DIR / "hypr" / "autostart.lua"
    if not path.exists():
        return False
    for line in path.read_text().splitlines():
        stripped = line.strip()
        if stripped.startswith("--"):
            continue
        if "launch_on_start" in stripped and "hyprsunset" in stripped:
            return True
    return False


def conf_is_ours() -> bool:
    return HYPRSUNSET_CONF.exists() and MARKER in HYPRSUNSET_CONF.read_text()


def disclosure() -> str:
    """Exactly what setup will change, given the state of this machine."""
    if not HYPRSUNSET_CONF.exists():
        conf_note = "Created. You do not currently have one."
    elif conf_is_ours():
        conf_note = "Rewritten. It is already a generated schedule."
    else:
        conf_note = (f"Replaced with a generated schedule. Your current file is copied to\n"
                     f"      {PRE_BACKUP.name}, and `nightlight-auto teardown` puts it back.")

    lines = [
        "Sunset Night Light setup",
        "",
        "This changes the following, and nothing else:",
        "",
        f"  {HYPRSUNSET_CONF}",
        f"      {conf_note}",
        "",
        f"  systemctl --user enable --now {HYPRSUNSET_UNIT}",
        "      hyprsunset starts from the unit its own package ships, rather than from",
        "      autostart.lua. Applying a rebuilt schedule means restarting hyprsunset,",
        "      and a uwsm transient scope does not survive a restart driven from a",
        "      systemd timer.",
    ]
    if autostart_launches_hyprsunset():
        lines += [
            "      NOTE: your autostart.lua already launches hyprsunset. Two launch paths",
            "      race for its socket, so remove that line after setup.",
        ]
    lines += [
        "",
        f"  {UNIT_DIR}/nightlight-auto.{{service,timer}}",
        "      A timer that rebuilds the schedule twice a day, because sunset moves.",
        "",
        f"  {HOOK_PATH}",
        "      Rebuilds the schedule when the desktop starts.",
        "",
        f"  {SETTINGS_PATH}",
        "      Created with defaults if you do not already have one.",
        "",
        "Nothing under /usr/share/omarchy is touched, and nothing reaches the network.",
        "",
        "Undo all of it with:  nightlight-auto teardown",
    ]
    return "\n".join(lines)


def is_paused() -> bool:
    return PAUSE_PATH.exists()


def set_paused(paused: bool) -> None:
    if paused:
        PAUSE_PATH.parent.mkdir(parents=True, exist_ok=True)
        PAUSE_PATH.touch()
    else:
        PAUSE_PATH.unlink(missing_ok=True)


# ---------------------------------------------------------------- commands


def gather(day: date | None = None):
    settings = load_settings()
    tz_name = system_timezone()
    tz = ZoneInfo(tz_name)
    lat, lon, source = resolve_location(settings, tz_name)
    today = day or datetime.now(tz).date()
    steps, info = build_schedule(settings, today, lat, lon, tz)
    return settings, tz_name, tz, lat, lon, source, today, steps, info


def cmd_generate(args) -> int:
    # The only thing in here that writes to the user's config, so this is where
    # consent is enforced. `setup` passes --accept once the user has agreed.
    if not is_setup() and not getattr(args, "accept", False):
        die("not set up yet, so nothing has been changed.\n"
            "       Run `nightlight-auto setup` to see what it would change and agree to it.")
    settings, tz_name, tz, lat, lon, source, today, steps, info = gather()
    if is_paused():
        body = render_paused_conf(tz_name)
    else:
        body = render_conf(steps, settings, info, lat, lon, source, tz_name)

    existing = HYPRSUNSET_CONF.read_text() if HYPRSUNSET_CONF.exists() else None
    if existing is not None and MARKER not in existing and not args.force:
        backup = HYPRSUNSET_CONF.with_suffix(
            f".conf.bak.{datetime.now(tz).strftime('%Y%m%d%H%M%S')}")
        backup.write_text(existing)
        info_msg(f"backed up your existing hyprsunset.conf to {backup.name}")

    if existing == body and not args.force:
        info_msg("schedule unchanged")
        return 0

    HYPRSUNSET_CONF.parent.mkdir(parents=True, exist_ok=True)
    HYPRSUNSET_CONF.write_text(body)

    restarted = restart_hyprsunset()
    if is_paused():
        info_msg("paused: the display stays untinted"
                 + ("; hyprsunset restarted" if restarted else ""))
        return 0
    save_state({
        "generated_for": today.isoformat(),
        "timezone": tz_name,
        "latitude": lat,
        "longitude": lon,
        "location_source": source,
        "sunset": info["sunset"].isoformat(),
        "sunrise": info["sunrise"].isoformat(),
        "ramp_start": info["ramp_start"].isoformat(),
        "ramp_end": info["ramp_end"].isoformat(),
        "day_start": info["day_start"].isoformat(),
        "steps": [[when.strftime("%H:%M"), temp] for when, temp in steps],
    })
    info_msg(
        f"wrote {len(steps)} profiles for {today} "
        f"(sunset {info['sunset'].strftime('%H:%M')}, "
        f"day returns {info['day_start'].strftime('%H:%M')})"
        + ("; hyprsunset restarted" if restarted else "")
    )
    return 0


def current_temperature() -> int | None:
    try:
        out = subprocess.run(["hyprctl", "hyprsunset", "temperature"],
                             capture_output=True, text=True, timeout=3)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return None
    digits = "".join(ch for ch in out.stdout if ch.isdigit() or ch == " ").split()
    return int(digits[0]) if digits else None


def cmd_status(args) -> int:
    settings, tz_name, tz, lat, lon, source, today, steps, info = gather()
    now = datetime.now(tz)

    # Walk the cycle to find which profile is live and which comes next.
    by_clock = sorted(steps, key=lambda item: item[0].strftime("%H:%M"))
    minutes_now = now.hour * 60 + now.minute
    active, upcoming = by_clock[-1], by_clock[0]
    for when, temp in by_clock:
        step_minutes = when.hour * 60 + when.minute
        if step_minutes <= minutes_now:
            active = (when, temp)
        else:
            upcoming = (when, temp)
            break

    payload = {
        "timezone": tz_name,
        "latitude": round(lat, 4),
        "longitude": round(lon, 4),
        "location_source": source,
        "sunset": info["sunset"].strftime("%H:%M"),
        "sunrise": info["sunrise"].strftime("%H:%M"),
        "estimated": info["degenerate"],
        "running": hyprsunset_running(),
        "scheduled_temperature": active[1],
        "scheduled_since": active[0].strftime("%H:%M"),
        "next_temperature": upcoming[1],
        "next_at": upcoming[0].strftime("%H:%M"),
        "actual_temperature": current_temperature(),
        "day_temp": settings["day_temp"],
        "evening_temp": settings["evening_temp"],
        "night_temp": settings["night_temp"],
        "generated": HYPRSUNSET_CONF.exists() and MARKER in HYPRSUNSET_CONF.read_text(),
        "paused": is_paused(),
        "setup": is_setup(),
    }
    if args.json:
        print(json.dumps(payload))
        return 0

    def label(temp):
        return "off (untinted)" if temp is None else f"{temp}K"

    if not payload["setup"]:
        print("state       NOT SET UP -- nothing has been changed on this machine.")
        print("            Run `nightlight-auto setup` to see what it would change.")
        print()
    print(f"time zone   {tz_name}")
    print(f"location    {lat:.4f}, {lon:.4f}  (from {source})")
    print(f"sun         rises {payload['sunrise']}, sets {payload['sunset']}"
          + ("  [estimated]" if payload["estimated"] else ""))
    print(f"hyprsunset  {'running' if payload['running'] else 'not running'}"
          + (f", currently {payload['actual_temperature']}K"
             if payload["actual_temperature"] else ""))
    if payload["paused"]:
        print("state       PAUSED -- untinted until `nightlight-auto resume`")
        print(f"would be    {label(active[1])} since {payload['scheduled_since']}")
    else:
        print(f"scheduled   {label(active[1])} since {payload['scheduled_since']}")
        print(f"next        {label(upcoming[1])} at {payload['next_at']}")
    if payload["setup"] and not payload["generated"]:
        warn("hyprsunset.conf is not the generated one; run `nightlight-auto generate`")
    return 0


def cmd_show(args) -> int:
    day = date.fromisoformat(args.date) if args.date else None
    settings, tz_name, tz, lat, lon, source, today, steps, info = gather(day)
    if getattr(args, "json", False):
        now = datetime.now(tz)
        minutes_now = now.hour * 60 + now.minute
        by_clock = sorted(steps, key=lambda item: item[0].strftime("%H:%M"))
        active_key = by_clock[-1][0].strftime("%H:%M")
        for when, _ in by_clock:
            if when.hour * 60 + when.minute <= minutes_now:
                active_key = when.strftime("%H:%M")
        print(json.dumps({
            "date": today.isoformat(),
            "timezone": tz_name,
            "sunset": info["sunset"].strftime("%H:%M"),
            "sunrise": info["sunrise"].strftime("%H:%M"),
            "estimated": info["degenerate"],
            "paused": is_paused(),
            "steps": [
                {
                    "time": when.strftime("%H:%M"),
                    "day": when.strftime("%a"),
                    "temperature": temp,
                    "current": when.strftime("%H:%M") == active_key,
                }
                for when, temp in steps
            ],
        }))
        return 0
    print(f"# {today}  {tz_name}  {lat:.4f},{lon:.4f} (from {source})")
    print(f"# sunset {info['sunset'].strftime('%H:%M')}, "
          f"sunrise {info['sunrise'].strftime('%H:%M')}"
          + ("  [estimated]" if info["degenerate"] else ""))
    for when, temp in steps:
        marker = "day" if temp is None else f"{temp}K"
        print(f"{when.strftime('%a %H:%M')}   {marker}")
    return 0


def cmd_pause(args) -> int:
    set_paused(True)
    args.force = True
    cmd_generate(args)
    return 0


def cmd_resume(args) -> int:
    set_paused(False)
    args.force = True
    cmd_generate(args)
    return 0


def cmd_toggle(args) -> int:
    set_paused(not is_paused())
    args.force = True
    cmd_generate(args)
    return 0


def cmd_setup(args) -> int:
    """Disclose every change, get consent, then activate. Nothing before this
    point writes to the user's configuration."""
    if getattr(args, "print_only", False):
        print(disclosure())
        return 0

    if is_setup() and not args.force:
        print("Already set up. `nightlight-auto teardown` undoes it, "
              "`--force` re-runs it.")
        return 0

    print(disclosure())
    print()

    if not args.yes:
        if not sys.stdin.isatty():
            die("setup needs a terminal to ask for consent; pass --yes to accept "
                "the changes listed above")
        try:
            reply = input('Type "yes" to make these changes: ').strip().lower()
        except (EOFError, KeyboardInterrupt):
            print()
            reply = ""
        if reply not in ("yes", "y"):
            print("Nothing was changed.")
            return 1

    record = {
        "version": 1,
        "accepted_at": datetime.now(ZoneInfo(system_timezone())).isoformat(),
        "backed_up_conf": None,
        "hyprsunset_unit_was_enabled": unit_enabled(HYPRSUNSET_UNIT),
        "units": [],
        "hook": None,
    }

    # 1. settings, only if absent -- never clobber an edited config
    if write_default_settings():
        info_msg(f"wrote {SETTINGS_PATH}")

    # 2. preserve whatever hyprsunset.conf is there now
    if HYPRSUNSET_CONF.exists() and not conf_is_ours():
        PRE_BACKUP.write_text(HYPRSUNSET_CONF.read_text())
        record["backed_up_conf"] = str(PRE_BACKUP)
        info_msg(f"saved your hyprsunset.conf to {PRE_BACKUP.name}")

    # 3. the daily rebuild
    UNIT_DIR.mkdir(parents=True, exist_ok=True)
    for name in ("nightlight-auto.service", "nightlight-auto.timer"):
        source = REPO / "systemd" / name
        if not source.exists():
            warn(f"missing {source}, skipping")
            continue
        (UNIT_DIR / name).write_text(source.read_text())
        record["units"].append(name)
    subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True)
    subprocess.run(["systemctl", "--user", "enable", "--now", "nightlight-auto.timer"],
                   capture_output=True)

    # 4. hyprsunset from its own unit
    subprocess.run(["systemctl", "--user", "enable", "--now", HYPRSUNSET_UNIT],
                   capture_output=True)

    # 5. rebuild when the desktop starts
    hook_source = REPO / "hooks" / "nightlight-auto.sh"
    if hook_source.exists():
        HOOK_PATH.parent.mkdir(parents=True, exist_ok=True)
        HOOK_PATH.write_text(hook_source.read_text())
        HOOK_PATH.chmod(0o755)
        record["hook"] = str(HOOK_PATH)

    CONSENT_PATH.parent.mkdir(parents=True, exist_ok=True)
    CONSENT_PATH.write_text(json.dumps(record, indent=2) + "\n")

    args.force = True
    args.accept = True
    cmd_generate(args)
    print()
    return cmd_status(argparse.Namespace(json=False))


def cmd_teardown(args) -> int:
    """Undo everything setup did, including putting the old config back."""
    if not is_setup() and not args.force:
        print("Not set up, so there is nothing to undo.")
        return 0

    record = read_consent()

    subprocess.run(["systemctl", "--user", "disable", "--now", "nightlight-auto.timer"],
                   capture_output=True)
    for name in record.get("units") or ["nightlight-auto.service", "nightlight-auto.timer"]:
        (UNIT_DIR / name).unlink(missing_ok=True)
    subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True)

    hook = record.get("hook")
    if hook:
        Path(hook).unlink(missing_ok=True)
    else:
        HOOK_PATH.unlink(missing_ok=True)

    # Put the user's own hyprsunset.conf back, or fall back to Omarchy's default
    # rather than leaving a generated schedule behind with nothing driving it.
    backup = record.get("backed_up_conf")
    if backup and Path(backup).exists():
        HYPRSUNSET_CONF.write_text(Path(backup).read_text())
        Path(backup).unlink(missing_ok=True)
        info_msg("restored your original hyprsunset.conf")
    elif conf_is_ours():
        restored = subprocess.run(
            ["omarchy-refresh-config", "hypr/hyprsunset.conf"], capture_output=True)
        if restored.returncode == 0:
            info_msg("restored Omarchy's default hyprsunset.conf")
        else:
            warn("could not restore hyprsunset.conf; run "
                 "`omarchy refresh config hypr/hyprsunset.conf`")

    # Only give hyprsunset's launch back if we were the ones who took it over.
    if not record.get("hyprsunset_unit_was_enabled", False):
        subprocess.run(["systemctl", "--user", "disable", HYPRSUNSET_UNIT],
                       capture_output=True)

    CONSENT_PATH.unlink(missing_ok=True)
    PAUSE_PATH.unlink(missing_ok=True)
    subprocess.run(["systemctl", "--user", "restart", HYPRSUNSET_UNIT], capture_output=True)

    print("Undone. Your settings in", SETTINGS_PATH, "were left alone;")
    print("delete", SETTINGS_PATH.parent, "if you want those gone too.")
    return 0


def cmd_init(args) -> int:
    created = write_default_settings()
    print(("wrote " if created else "already present: ") + str(SETTINGS_PATH))
    return 0


# ------------------------------------------------------------------- utils


def warn(message: str) -> None:
    print(f"nightlight-auto: warning: {message}", file=sys.stderr)


def info_msg(message: str) -> None:
    if not os.environ.get("NIGHTLIGHT_AUTO_QUIET"):
        print(f"nightlight-auto: {message}", file=sys.stderr)


def die(message: str):
    print(f"nightlight-auto: error: {message}", file=sys.stderr)
    raise SystemExit(1)


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="nightlight-auto",
        description="Generate a sunset-tracked hyprsunset schedule.")
    sub = parser.add_subparsers(dest="command")

    gen = sub.add_parser("generate", help="rebuild hyprsunset.conf for tonight")
    gen.add_argument("--force", action="store_true",
                     help="rewrite even if nothing changed")
    gen.add_argument("--accept", action="store_true",
                     help=argparse.SUPPRESS)  # used internally by `setup`
    gen.set_defaults(func=cmd_generate)

    status = sub.add_parser("status", help="what is scheduled right now")
    status.add_argument("--json", action="store_true")
    status.set_defaults(func=cmd_status)

    show = sub.add_parser("show", help="print tonight's ladder without writing")
    show.add_argument("--date", help="a different date, YYYY-MM-DD")
    show.add_argument("--json", action="store_true")
    show.set_defaults(func=cmd_show)

    pause = sub.add_parser("pause", help="stop tinting until resumed")
    pause.set_defaults(func=cmd_pause)

    resume = sub.add_parser("resume", help="put the sunset ramp back")
    resume.set_defaults(func=cmd_resume)

    toggle = sub.add_parser("toggle", help="pause if running, resume if paused")
    toggle.set_defaults(func=cmd_toggle)

    setup = sub.add_parser(
        "setup", help="show what would change, then activate once you agree")
    setup.add_argument("--yes", action="store_true",
                       help="accept the listed changes without prompting")
    setup.add_argument("--print", dest="print_only", action="store_true",
                       help="print what would change and exit, changing nothing")
    setup.add_argument("--force", action="store_true", help="re-run even if set up")
    setup.set_defaults(func=cmd_setup)

    teardown = sub.add_parser("teardown", help="undo everything setup did")
    teardown.add_argument("--force", action="store_true",
                          help="run even if no consent record is present")
    teardown.set_defaults(func=cmd_teardown)

    init = sub.add_parser("init", help="write a starting config file")
    init.set_defaults(func=cmd_init)

    args = parser.parse_args()
    if not getattr(args, "func", None):
        parser.print_help()
        return 1
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
